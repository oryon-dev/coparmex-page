---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Contacto y Afiliación">
  <section
    class="w-full flex flex-col md:flex-row min-h-[800px] border-b border-[var(--color-outline-variant)]"
  >
    <!-- Mitad Izquierda -->
    <div
      class="w-full md:w-1/2 bg-[var(--color-tertiary)] text-white p-[var(--spacing-margin-mobile)] md:p-[var(--spacing-margin-desktop)] flex flex-col justify-center relative overflow-hidden"
    >
      <div class="absolute inset-0 opacity-10 pointer-events-none">
        <svg height="100%" width="100%" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <pattern
              height="40"
              id="grid"
              patternUnits="userSpaceOnUse"
              width="40"
            >
              <path
                d="M 40 0 L 0 0 0 40"
                fill="none"
                stroke="currentColor"
                stroke-width="1"></path>
            </pattern>
          </defs>
          <rect fill="url(#grid)" height="100%" width="100%"></rect>
        </svg>
      </div>

      <div
        class="relative z-10 max-w-xl mx-auto md:ml-auto md:mr-0 w-full lg:pr-12"
      >
        <h1
          class="font-playfair font-black text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight"
        >
          Estamos para servirte
        </h1>
        <p class="font-inter font-light text-lg text-white/90 mb-12 max-w-md">
          Comunícate con nosotros para resolver cualquier duda sobre afiliación,
          servicios institucionales o representación empresarial.
        </p>

        <div class="space-y-8">
          <!-- Ubicación -->
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-3xl mt-1 opacity-80"
              >location_on</span
            >
            <div>
              <h3
                class="font-montserrat font-semibold text-sm uppercase tracking-widest text-white/80 mb-1"
              >
                Nuestras Oficinas
              </h3>
              <p class="font-inter text-base font-light">
                Calle 62 N° 129 entre 25 y 29, Fraccionamiento Xcorazón. <br
                />Valladolid, Yucatán, 97780
              </p>
            </div>
          </div>
          <!-- Teléfono -->
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-3xl mt-1 opacity-80"
              >call</span
            >
            <div>
              <h3
                class="font-montserrat font-semibold text-sm uppercase tracking-widest text-white/80 mb-1"
              >
                Teléfono
              </h3>
              <a
                href="tel:+529858560731"
                class="font-inter text-base font-light hover:text-[var(--color-primary-container)] transition-colors transition-colors"
                >+52 (985) 856 0731</a
              >
            </div>
          </div>
          <!-- Correo -->
          <div class="flex items-start gap-4">
            <span class="material-symbols-outlined text-3xl mt-1 opacity-80"
              >mail</span
            >
            <div>
              <h3
                class="font-montserrat font-semibold text-sm uppercase tracking-widest text-white/80 mb-1"
              >
                Correo Electrónico
              </h3>
              <a
                href="mailto:contacto@coparmexvalladolid.org.mx"
                class="font-inter text-base font-light hover:text-[var(--color-primary-container)] transition-colors transition-colors"
              >
                contacto@coparmexvalladolid.org.mx
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Mitad Derecha: Formulario Limpio -->
    <div
      class="w-full md:w-1/2 bg-white p-[var(--spacing-margin-mobile)] md:p-[var(--spacing-margin-desktop)] flex flex-col justify-center"
    >
      <div
        class="max-w-xl mx-auto md:mr-auto md:ml-0 w-full lg:pl-12 py-12 md:py-0"
      >
        <h2
          class="font-playfair font-bold text-3xl md:text-4xl text-[var(--color-primary)] mb-8"
        >
          Envíanos un mensaje
        </h2>

        <form
          class="space-y-6"
          onsubmit="event.preventDefault(); alert('Mensaje enviado exitosamente');"
        >
          <!-- Input Flotante: Nombre -->
          <div class="relative group">
            <input
              class="block w-full px-4 pt-6 pb-2 text-[var(--color-on-surface)] bg-transparent border border-[var(--color-outline-variant)] rounded-md appearance-none focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] peer transition-colors"
              id="nombre"
              name="nombre"
              placeholder=" "
              type="text"
              required
            />
            <label
              class="absolute text-[var(--color-on-surface-variant)] duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 font-inter font-light pointer-events-none"
              for="nombre">Nombre Completo</label
            >
          </div>

          <!-- Input Flotante: Correo -->
          <div class="relative group">
            <input
              class="block w-full px-4 pt-6 pb-2 text-[var(--color-on-surface)] bg-transparent border border-[var(--color-outline-variant)] rounded-md appearance-none focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] peer transition-colors"
              id="email"
              name="email"
              placeholder=" "
              type="email"
              required
            />
            <label
              class="absolute text-[var(--color-on-surface-variant)] duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 font-inter font-light pointer-events-none"
              for="email">Correo Electrónico</label
            >
          </div>

          <!-- Input Flotante: Empresa -->
          <div class="relative group">
            <input
              class="block w-full px-4 pt-6 pb-2 text-[var(--color-on-surface)] bg-transparent border border-[var(--color-outline-variant)] rounded-md appearance-none focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] peer transition-colors"
              id="empresa"
              name="empresa"
              placeholder=" "
              type="text"
            />
            <label
              class="absolute text-[var(--color-on-surface-variant)] duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 font-inter font-light pointer-events-none"
              for="empresa">Empresa (Opcional)</label
            >
          </div>

          <!-- Select: Asunto -->
          <div class="relative group">
            <select
              class="block w-full px-4 pt-6 pb-2 text-[var(--color-on-surface)] bg-transparent border border-[var(--color-outline-variant)] rounded-md appearance-none focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] peer transition-colors cursor-pointer"
              id="asunto"
              name="asunto"
              required
            >
              <option disabled selected value=""></option>
              <option value="afiliacion">Información sobre Afiliación</option>
              <option value="servicios">Servicios Institucionales</option>
              <option value="eventos">Eventos y Capacitación</option>
              <option value="otro">Otro</option>
            </select>
            <label
              class="absolute text-[var(--color-on-surface-variant)] duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 font-inter font-light pointer-events-none"
              for="asunto">Asunto</label
            >
            <span
              class="material-symbols-outlined absolute right-4 top-4 text-[var(--color-outline-variant)] pointer-events-none"
              >expand_more</span
            >
          </div>

          <!-- Textarea: Mensaje -->
          <div class="relative group">
            <textarea
              class="block w-full px-4 pt-6 pb-2 text-[var(--color-on-surface)] bg-transparent border border-[var(--color-outline-variant)] rounded-md appearance-none focus:outline-none focus:ring-0 focus:border-[var(--color-primary)] peer transition-colors resize-none"
              id="mensaje"
              name="mensaje"
              placeholder=" "
              rows="4"
              required></textarea>
            <label
              class="absolute text-[var(--color-on-surface-variant)] duration-300 transform -translate-y-3 scale-75 top-4 z-10 origin-[0] left-4 peer-placeholder-shown:scale-100 peer-placeholder-shown:translate-y-0 peer-focus:scale-75 peer-focus:-translate-y-3 font-inter font-light pointer-events-none"
              for="mensaje">Mensaje</label
            >
          </div>

          <!-- Botón de Envío -->
          <button
            class="w-full bg-[var(--color-primary)] text-white font-montserrat font-semibold text-sm tracking-widest uppercase py-4 px-6 rounded-md hover:bg-[var(--color-primary-container)] transition-all shadow-md transform hover:-translate-y-1 flex items-center justify-center gap-3"
            type="submit"
          >
            <span>Enviar Mensaje</span>
            <span class="material-symbols-outlined text-[20px]">send</span>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section
    class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-[var(--color-surface-bright)]"
  >
    <div
      class="max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <div class="text-center mb-12">
        <h2
          class="font-playfair font-bold text-3xl md:text-4xl text-[var(--color-primary)] mb-4"
        >
          Preguntas Frecuentes
        </h2>
        <p
          class="font-inter text-lg text-[var(--color-on-surface-variant)] font-light max-w-2xl mx-auto"
        >
          Encuentra respuestas rápidas a las consultas más comunes de nuestros
          futuros afiliados.
        </p>
      </div>

      <div
        class="max-w-3xl mx-auto bg-white border border-[var(--color-outline-variant)]/50 rounded-xl shadow-sm overflow-hidden"
      >
        <!-- Accordion Item 1 -->
        <div
          class="accordion-item border-b border-[var(--color-outline-variant)]/50 last:border-b-0"
        >
          <button
            class="accordion-button w-full flex justify-between items-center py-6 px-6 focus:outline-none text-left group bg-white hover:bg-[var(--color-surface-bright)] transition-colors"
          >
            <span
              class="font-montserrat font-semibold text-[var(--color-on-surface)] group-hover:text-[var(--color-primary)] transition-colors text-base md:text-lg"
              >¿Cuáles son los requisitos para afiliarme a COPARMEX Valladolid?</span
            >
            <span
              class="material-symbols-outlined accordion-icon text-[var(--color-outline-variant)] group-hover:text-[var(--color-primary)] transition-transform duration-300"
              >expand_more</span
            >
          </button>
          <div class="accordion-content px-6 bg-white">
            <p
              class="font-inter text-base text-[var(--color-on-surface-variant)] font-light pb-6 leading-relaxed"
            >
              Para afiliarse, necesita ser un empresario formalmente
              constituido, compartir los principios y valores de COPARMEX, y
              presentar su solicitud de ingreso junto con documentación básica
              de la empresa y representante legal.
            </p>
          </div>
        </div>

        <!-- Accordion Item 2 -->
        <div
          class="accordion-item border-b border-[var(--color-outline-variant)]/50 last:border-b-0"
        >
          <button
            class="accordion-button w-full flex justify-between items-center py-6 px-6 focus:outline-none text-left group bg-white hover:bg-[var(--color-surface-bright)] transition-colors"
          >
            <span
              class="font-montserrat font-semibold text-[var(--color-on-surface)] group-hover:text-[var(--color-primary)] transition-colors text-base md:text-lg"
              >¿Qué beneficios obtengo al ser socio?</span
            >
            <span
              class="material-symbols-outlined accordion-icon text-[var(--color-outline-variant)] group-hover:text-[var(--color-primary)] transition-transform duration-300"
              >expand_more</span
            >
          </button>
          <div class="accordion-content px-6 bg-white">
            <p
              class="font-inter text-base text-[var(--color-on-surface-variant)] font-light pb-6 leading-relaxed"
            >
              Los socios obtienen representación institucional ante autoridades,
              acceso a capacitaciones exclusivas, networking empresarial de alto
              nivel, asesoría legal y fiscal, y participación en las comisiones
              de trabajo para impulsar el desarrollo económico local.
            </p>
          </div>
        </div>

        <!-- Accordion Item 3 -->
        <div
          class="accordion-item border-b border-[var(--color-outline-variant)]/50 last:border-b-0"
        >
          <button
            class="accordion-button w-full flex justify-between items-center py-6 px-6 focus:outline-none text-left group bg-white hover:bg-[var(--color-surface-bright)] transition-colors"
          >
            <span
              class="font-montserrat font-semibold text-[var(--color-on-surface)] group-hover:text-[var(--color-primary)] transition-colors text-base md:text-lg"
              >¿Tienen programas de capacitación para mi equipo?</span
            >
            <span
              class="material-symbols-outlined accordion-icon text-[var(--color-outline-variant)] group-hover:text-[var(--color-primary)] transition-transform duration-300"
              >expand_more</span
            >
          </button>
          <div class="accordion-content px-6 bg-white">
            <p
              class="font-inter text-base text-[var(--color-on-surface-variant)] font-light pb-6 leading-relaxed"
            >
              Sí, organizamos talleres, diplomados y conferencias mensualmente
              enfocados en desarrollo humano, actualización fiscal, innovación
              tecnológica y liderazgo, con tarifas preferenciales para
              colaboradores de empresas afiliadas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Location Map Section -->
  <section class="bg-white">
    <div
      class="w-full h-[450px] md:h-[550px] bg-[var(--color-surface-container)] relative"
    >
      <!-- Integración real de Google Maps -->
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3732.28477611958!2d-88.21972932475241!3d20.698657480869308!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f510ad9aca8c247%3A0xbb8e3505758882b4!2sCOPARMEX%20Valladolid!5e0!3m2!1ses!2smx!4v1783554317896!5m2!1ses!2smx"
        class="absolute inset-0 w-full h-full z-0"
        style="border:0;"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"></iframe>

      <!-- Floating Info Card (Reposicionada a la esquina inferior) -->
      <div
        class="absolute bottom-6 left-1/2 transform -translate-x-1/2 md:bottom-10 md:left-10 md:translate-x-0 bg-white/95 backdrop-blur-sm p-6 shadow-2xl border border-[var(--color-outline-variant)]/40 rounded-xl max-w-sm w-[90%] md:w-[350px] text-left z-10 transition-transform hover:scale-105 duration-300"
      >
        <div class="flex items-center gap-3 mb-3">
          <span
            class="material-symbols-outlined text-[var(--color-primary)] text-3xl"
            >corporate_fare</span
          >
          <h3
            class="font-montserrat font-bold text-base uppercase tracking-wider text-[var(--color-primary)]"
          >
            Sede COPARMEX
          </h3>
        </div>
        <p
          class="font-inter text-sm text-[var(--color-on-surface-variant)] font-light leading-relaxed"
        >
          Ubicados estratégicamente en el corazón económico de la región para
          servir mejor a nuestros agremiados.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .accordion-content {
    transition:
      max-height 0.4s cubic-bezier(0, 1, 0, 1),
      opacity 0.3s ease-out,
      padding 0.3s ease-out;
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding-top: 0;
    padding-bottom: 0;
  }
  .accordion-item.active .accordion-content {
    max-height: 1000px;
    opacity: 1;
    transition:
      max-height 0.5s ease-in-out,
      opacity 0.4s ease-in,
      padding 0.4s ease-in;
  }
  .accordion-item.active .accordion-icon {
    transform: rotate(180deg);
  }
</style>

<script>
  // Lógica del Acordeón
  document.addEventListener("DOMContentLoaded", () => {
    const accordionButtons = document.querySelectorAll(".accordion-button");

    accordionButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const currentItem = button.closest(".accordion-item");

        document.querySelectorAll(".accordion-item").forEach((item) => {
          if (item !== currentItem) {
            item.classList.remove("active");
          }
        });

        if (currentItem) {
          currentItem.classList.toggle("active");
        }
      });
    });
  });
</script>
