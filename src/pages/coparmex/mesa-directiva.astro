---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeadershipCard from "../../components/nosotros/LeadershipCard.astro";
import { Image } from "astro:assets";
import fotoPresidente from "../../assets/pages/mesa-directiva/presidente-coparmex.png";
import placeholderHombre from "../../assets/shared/placeholder-hombre.png";
import placeholderMujer from "../../assets/shared/placeholder-mujer.png";

import imgDirectivos from "../../assets/pages/mesa-directiva/directivos.png";

const imgTemporal = fotoPresidente;

// Datos del Presidente
const presidente = {
  role: "Presidente",
  name: "M.F. Isaac Emilio Díaz Alcocer",
  company: "Director en Grupo Díaz Alcocer",
  image: fotoPresidente,
  email: "presidencia@coparmexvalladolid.org.mx",
  linkedin: "https://mx.linkedin.com/in/isaac-díaz-alcocer-15a4606b",
};

// Array del Consejo Ejecutivo
const consejoEjecutivo = [
  {
    role: "Vicepresidencia Ejecutiva",
    name: "C.P. Ana Elena Ruiz",
    company: "Directora General de Consultoría Fiscal AR",
    image: placeholderMujer,
    email: "vicepresidencia@coparmexvalladolid.org",
    linkedin: "#",
  },
  {
    role: "Secretario",
    name: "Ing. Roberto Duarte",
    company: "Socio Fundador de TechLogistics México",
    image: placeholderHombre,
    email: "secretaria@coparmexvalladolid.org",
    linkedin: "#",
  },
  {
    role: "Tesorero",
    name: "Lic. Miguel Sosa Lara",
    company: "Director Regional de Banco Oriente",
    image: placeholderHombre,
    email: "tesoreria@coparmexvalladolid.org",
    linkedin: "#",
  },
];

// Array de las Direcciones de Comisiones
const comisiones = [
  {
    area: "Asuntos Legales",
    name: "Abog. Sofia Marín",
    company: "Bufete Marín & Asociados",
    icon: "gavel",
  },
  {
    area: "Networking",
    name: "Lic. Eduardo Peniche",
    company: "Eventos Premier Valladolid",
    icon: "handshake",
  },
  {
    area: "Educación",
    name: "Dra. Claudia Ortiz",
    company: "Instituto de Liderazgo Regional",
    icon: "school",
  },
  {
    area: "Economía",
    name: "Mtro. Jorge Cetina",
    company: "Inversiones Valladolid S.A.",
    icon: "trending_up",
  },
  {
    area: "Responsabilidad Social",
    name: "Lic. Beatriz Luna",
    company: "Fundación Progreso Maya",
    icon: "diversity_3",
  },
  {
    area: "Emprendimiento",
    name: "Ing. Karla Mendez",
    company: "Hub Creativo Valladolid",
    icon: "monitoring",
  },
  {
    area: "Turismo",
    name: "Don Felipe Valencia",
    company: "Hotel Casa del Oriente",
    icon: "public",
  },
  {
    area: "Seguridad Jurídica",
    name: "Lic. Alejandro Cruz",
    company: "Notaría Pública No. 12",
    icon: "verified_user",
  },
];
---

<BaseLayout title="Mesa Directiva | COPARMEX Valladolid">
  <main class="w-full">
    <!-- Hero Section -->
    <section
      class="relative h-[400px] md:h-[500px] overflow-hidden flex items-center"
    >
      <div class="absolute inset-0 z-0 bg-[var(--color-surface-container)]">
        <Image
          src={imgDirectivos}
          alt="Mesa Directiva Fondo"
          class="w-full h-full object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-r from-[var(--color-primary)]/95 to-[var(--color-primary)]/60"
        >
        </div>
      </div>

      <div
        class="relative z-10 max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] w-full"
      >
        <div class="max-w-2xl text-white">
          <span
            class="font-montserrat font-bold text-xs uppercase tracking-widest mb-4 block text-[var(--color-primary-fixed-dim)]"
            >Liderazgo Institucional</span
          >
          <h1
            class="font-playfair font-black text-4xl md:text-5xl lg:text-6xl mb-6 leading-tight"
          >
            Nuestra Mesa Directiva
          </h1>
          <p class="font-inter text-lg opacity-90 font-light leading-relaxed">
            Contamos con un equipo multidisciplinario de líderes comprometidos
            con la integridad, la innovación y el desarrollo económico
            sostenible de nuestra región.
          </p>
        </div>
      </div>
    </section>

    <!-- Nivel 1: Presidencia -->
    <section
      class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-white max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <div class="flex flex-col items-center mb-16">
        <div class="w-24 h-1 bg-[var(--color-primary)] mb-8 rounded-full"></div>
        <h2
          class="font-playfair font-bold text-3xl md:text-4xl text-center text-[var(--color-primary)]"
        >
          Presidencia
        </h2>
      </div>

      <div class="flex justify-center w-full">
        <div class="max-w-3xl w-full">
          <LeadershipCard {...presidente} />
        </div>
      </div>
    </section>

    <!-- Nivel 2: Consejo Ejecutivo -->
    <section
      class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-[var(--color-surface-bright)] border-y border-[var(--color-outline-variant)]/30"
    >
      <div
        class="max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
      >
        <div class="flex flex-col items-center mb-16 text-center">
          <h2
            class="font-playfair font-bold text-3xl md:text-4xl text-[var(--color-primary)] mb-4"
          >
            Consejo Ejecutivo
          </h2>
          <p
            class="font-inter text-[var(--color-on-surface-variant)] text-lg font-light"
          >
            Los pilares de nuestra gestión estratégica
          </p>
        </div>

        <!-- GRID Responsivo: 1 columna celular, 2 columnas monitores -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-10">
          {consejoEjecutivo.map((lider) => <LeadershipCard {...lider} />)}
        </div>
      </div>
    </section>

    <!-- Nivel 3: Direcciones de Comisiones -->
    <section
      class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-white max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <div class="mb-16">
        <h2
          class="font-playfair font-bold text-3xl md:text-4xl text-[var(--color-primary)] border-l-4 border-[var(--color-primary)] pl-6"
        >
          Direcciones de Comisiones
        </h2>
        <p
          class="font-inter text-[var(--color-on-surface-variant)] text-lg font-light mt-4 md:ml-7"
        >
          Expertos liderando áreas clave para el fortalecimiento empresarial.
        </p>
      </div>

      <!-- Grid de Comisiones -->
      <div
        class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8"
      >
        {
          comisiones.map((comision) => (
            <div class="p-6 md:p-8 bg-white border border-[var(--color-outline-variant)]/40 rounded-xl shadow-sm hover:-translate-y-1 hover:shadow-md transition-all duration-300">
              <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-12 bg-[var(--color-surface-container)] rounded-lg flex items-center justify-center text-[var(--color-primary)]">
                  <span class="material-symbols-outlined">{comision.icon}</span>
                </div>
                <div>
                  <h5 class="font-montserrat font-bold text-xs text-[var(--color-primary)] uppercase tracking-wider">
                    {comision.area}
                  </h5>
                </div>
              </div>
              <p class="font-inter font-semibold text-[var(--color-on-surface)] mb-1">
                {comision.name}
              </p>
              <p class="font-inter text-sm text-[var(--color-on-surface-variant)] font-light">
                {comision.company}
              </p>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
