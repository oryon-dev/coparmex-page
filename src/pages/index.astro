    </div>
  </section>

  <!-- Checklist Benefits with Imagery -->
  <section
    class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-[var(--color-surface-container-lowest)]"
  >
    <div
      class="max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <div
        class="grid grid-cols-1 lg:grid-cols-2 gap-12 md:gap-20 items-center"
      >
        <div class="reveal">
          <span
            class="text-[var(--color-primary)] font-montserrat font-semibold text-xs tracking-widest uppercase mb-4 block"
            >El Valor de la Afiliación</span
          >
          <h2
            class="font-playfair font-bold text-3xl md:text-5xl text-[var(--color-on-surface)] mb-10 heading-transition leading-tight"
          >
            Beneficios Tangibles para una Visión a Largo Plazo.
          </h2>
          <ul class="space-y-8">
            <li
              class="flex items-start gap-6 group hover:translate-x-2 transition-transform"
            >
              <div
                class="w-12 h-12 rounded-full bg-[var(--color-primary-fixed)] flex items-center justify-center shrink-0 group-hover:bg-[var(--color-primary)] transition-colors"
              >
                <span
                  class="material-symbols-outlined text-[var(--color-primary)] text-xl group-hover:text-white transition-colors"
                  >handshake</span
                >
              </div>
              <div>
                <h4
                  class="font-playfair font-bold text-xl text-[var(--color-on-surface)] mb-2"
                >
                  Convenios Exclusivos B2B
                </h4>
                <p
                  class="font-inter font-light text-base text-[var(--color-on-surface-variant)]"
                >
                  Acceso a condiciones preferenciales en una red cerrada de
                  proveedores y socios de primer nivel.
                </p>
              </div>
            </li>
            <li
              class="flex items-start gap-6 group hover:translate-x-2 transition-transform"
            >
              <div
                class="w-12 h-12 rounded-full bg-[var(--color-primary-fixed)] flex items-center justify-center shrink-0 group-hover:bg-[var(--color-primary)] transition-colors"
              >
                <span
                  class="material-symbols-outlined text-[var(--color-primary)] text-xl group-hover:text-white transition-colors"
                  >campaign</span
                >
              </div>
              <div>
                <h4
                  class="font-playfair font-bold text-xl text-[var(--color-on-surface)] mb-2"
                >
                  Incidencia en Políticas Públicas
                </h4>
                <p
                  class="font-inter font-light text-base text-[var(--color-on-surface-variant)]"
                >
                  Respaldo institucional sólido para llevar la voz del
                  empresariado a las mesas de decisión gubernamental.
                </p>
              </div>
            </li>
            <li
              class="flex items-start gap-6 group hover:translate-x-2 transition-transform"
            >
              <div
                class="w-12 h-12 rounded-full bg-[var(--color-primary-fixed)] flex items-center justify-center shrink-0 group-hover:bg-[var(--color-primary)] transition-colors"
              >
                <span
                  class="material-symbols-outlined text-[var(--color-primary)] text-xl group-hover:text-white transition-colors"
                  >trending_up</span
                >
              </div>
              <div>
                <h4
                  class="font-playfair font-bold text-xl text-[var(--color-on-surface)] mb-2"
                >
                  Desarrollo de Liderazgo Sectorial
                </h4>
                <p
                  class="font-inter font-light text-base text-[var(--color-on-surface-variant)]"
                >
                  Participación activa en comisiones de trabajo para moldear el
                  futuro de tu industria.
                </p>
              </div>
            </li>
            <li
              class="flex items-start gap-6 group hover:translate-x-2 transition-transform"
            >
              <div
                class="w-12 h-12 rounded-full bg-[var(--color-primary-fixed)] flex items-center justify-center shrink-0 group-hover:bg-[var(--color-primary)] transition-colors"
              >
                <span
                  class="material-symbols-outlined text-[var(--color-primary)] text-xl group-hover:text-white transition-colors"
                  >support_agent</span
                >
              </div>
              <div>
                <h4
                  class="font-playfair font-bold text-xl text-[var(--color-on-surface)] mb-2"
                >
                  Consultoría Ejecutiva Directa
                </h4>
                <p
                  class="font-inter font-light text-base text-[var(--color-on-surface-variant)]"
                >
                  Línea directa para asesoría especializada en coyunturas
                  fiscales, laborales y de regulación.
                </p>
              </div>
            </li>
          </ul>
        </div>
        <div class="relative reveal" style="transition-delay: 200ms;">
          <div
            class="absolute -inset-4 border-2 border-[var(--color-primary-fixed)] rounded-sm transform translate-x-4 translate-y-4"
          >
          </div>
          <Image
            alt="Beneficios tangibles"
            class="relative z-10 w-full h-auto md:h-[700px] object-cover rounded-sm shadow-2xl hover:scale-[1.02] transition-transform duration-700"
            src={beneficios}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Partner Highlight & Logos -->
  <section
    class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-[var(--color-surface-container)]"
    id="socios"
  >
    <div
      class="max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <div class="text-center mb-16 reveal">
        <span
          class="text-[var(--color-primary)] font-montserrat font-semibold text-xs tracking-widest uppercase mb-4 block"
          >Nuestra Comunidad</span
        >
        <h2
          class="font-playfair font-bold text-3xl md:text-5xl text-[var(--color-on-surface)] mb-6 heading-transition"
        >
          Red de Excelencia Empresarial
        </h2>
      </div>

      <!-- Partner of the Month Highlight -->
      <div
        class="bg-[var(--color-surface-container-lowest)] p-6 md:p-10 rounded-sm shadow-md mb-12 flex flex-col md:flex-row gap-8 items-center border border-[var(--color-outline-variant)]/30 max-w-4xl mx-auto reveal group"
      >
        <div
          class="w-full md:w-1/3 shrink-0 flex justify-center md:border-r border-[var(--color-outline-variant)]/50 md:pr-8"
        >
          <Image
            class="max-w-[150px] md:max-w-[200px] object-contain transform group-hover:scale-110 transition-transform duration-500"
            alt="Grupo Mesones - Valladolid"
            src={GMesonesLogo}
          />
        </div>
        <div class="w-full md:w-2/3 text-center md:text-left">
          <div
            class="flex flex-col sm:flex-row items-center justify-center md:justify-start gap-4 mb-4"
          >
            <span
              class="bg-[var(--color-primary)] text-white font-montserrat font-semibold text-xs px-4 py-1 uppercase tracking-widest"
              >Socio Destacado del Mes</span
            >
            <span
              class="text-[var(--color-on-surface-variant)] text-sm font-semibold tracking-wide"
              >Sector Turismo</span
            >
          </div>
          <h3
            class="font-playfair font-bold text-2xl md:text-3xl text-[var(--color-on-surface)] mb-6"
          >
            Grupo Mesones
          </h3>
          <p
            class="font-inter font-light text-lg text-[var(--color-on-surface-variant)] italic mb-8 border-l-4 border-[var(--color-primary)] pl-6 text-left"
          >
            "Nuestra afiliación a COPARMEX ha sido fundamental para consolidar
            nuestras operaciones en la región, permitiéndonos elevar los
            estándares de hospitalidad mientras contribuimos al desarrollo
            económico ordenado de Valladolid."
          </p>
          <button
            class="text-[var(--color-primary)] font-montserrat font-semibold uppercase tracking-widest text-sm hover:text-[var(--color-primary-container)] flex items-center justify-center md:justify-start gap-2 group-hover:translate-x-2 transition-transform mx-auto md:mx-0"
          >
            <!-- Leer Caso de Éxito <span class="material-symbols-outlined text-sm"
              >arrow_forward</span
            > -->
          </button>
        </div>
      </div>

      <div class="text-center mt-12 reveal">
        <a
          href="/socios/directorio"
          class="inline-block bg-transparent border border-[var(--color-outline)] text-[var(--color-on-surface)] font-montserrat font-semibold px-10 py-4 hover:border-[var(--color-primary)] hover:text-[var(--color-primary)] transition-all tracking-widest uppercase text-sm transform hover:scale-105 hover:-translate-y-1"
        >
          Explorar Directorio Completo
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Clases específicas para efectos visuales del Home (Los generales viven en global.css) */
  .hero-overlay {
    background: linear-gradient(
      135deg,
      rgba(0, 50, 138, 0.6) 0%,
      rgba(2, 25, 114, 0.75) 100%
    );
  }

  .editorial-image-mask {
    clip-path: polygon(0 0, 100% 5%, 100% 95%, 0 100%);
  }

  .editorial-image-mask-alt {
    clip-path: polygon(0 5%, 100% 0, 100% 100%, 0 95%);
  }

  /* Shader Canvas */
  #shader-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    opacity: 0.4;
    pointer-events: none;
  }
</style>

<script>
  // 1. Intersection Observer para animaciones de revelado (.reveal)
  const observerOptions = {
    threshold: 0.1,
    rootMargin: "0px 0px -50px 0px",
  };

  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("active");
        // revealObserver.unobserve(entry.target); // Opcional: descomentar si solo quieres que anime una vez
      }
    });
  }, observerOptions);

  document
    .querySelectorAll(".reveal")
    .forEach((el) => revealObserver.observe(el));

  // 2. WebGL/Canvas Shader para el fondo animado del Hero (Efecto de red/nodos)
  const createShaderBg = () => {
    const container = document.getElementById("shader-bg");
    if (!container) return;

    const canvas = document.createElement("canvas");
    container.appendChild(canvas);
    const gl = canvas.getContext("webgl");
    if (!gl) return;

    const resize = () => {
      canvas.width = container.clientWidth;
      canvas.height = container.clientHeight;
      gl.viewport(0, 0, canvas.width, canvas.height);
    };
    window.addEventListener("resize", resize);
    resize();

    const vs = `
      attribute vec2 position;
      void main() { gl_Position = vec4(position, 0.0, 1.0); }
    `;

    // Shader que dibuja ondas sutiles azules
    const fs = `
      precision mediump float;
      uniform float time;
      uniform vec2 resolution;
      void main() {
        vec2 uv = gl_FragCoord.xy / resolution.xy;
        float color = 0.5 + 0.5 * sin(time + uv.x * 10.0 + uv.y * 5.0);
        gl_FragColor = vec4(0.0, 0.2, 0.5, color * 0.15);
      }
    `;

    const createShader = (
      gl: WebGLRenderingContext,
      type: number,
      source: string,
    ) => {
      const s = gl.createShader(type);
      if (!s) return null;
      gl.shaderSource(s, source);
      gl.compileShader(s);
      return s;
    };

    const program = gl.createProgram();
    if (!program) return;

    const vertexShader = createShader(gl, gl.VERTEX_SHADER, vs);
    const fragmentShader = createShader(gl, gl.FRAGMENT_SHADER, fs);

    if (vertexShader && fragmentShader) {
      gl.attachShader(program, vertexShader);
      gl.attachShader(program, fragmentShader);
      gl.linkProgram(program);
      gl.useProgram(program);

      const posAttr = gl.getAttribLocation(program, "position");
      const posBuffer = gl.createBuffer();
      gl.bindBuffer(gl.ARRAY_BUFFER, posBuffer);
      gl.bufferData(
        gl.ARRAY_BUFFER,
        new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]),
        gl.STATIC_DRAW,
      );
      gl.enableVertexAttribArray(posAttr);
      gl.vertexAttribPointer(posAttr, 2, gl.FLOAT, false, 0, 0);

      const timeUni = gl.getUniformLocation(program, "time");
      const resUni = gl.getUniformLocation(program, "resolution");

      const render = (now: number) => {
        gl.uniform1f(timeUni, now * 0.001);
        gl.uniform2f(resUni, canvas.width, canvas.height);
        gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
        requestAnimationFrame(render);
      };
      requestAnimationFrame(render);
    }
  };

  // En Astro, aseguramos que el script se ejecute cuando el DOM cargue
  document.addEventListener("DOMContentLoaded", createShaderBg);
</script>
