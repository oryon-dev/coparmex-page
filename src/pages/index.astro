        <div class="w-24 h-1 bg-[var(--color-primary)] mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
        <!-- Tarjeta 1 -->
        <div
          class="group reveal card-glow p-4 rounded-xl border border-transparent bg-white shadow-sm"
        >
          <div class="h-64 mb-8 overflow-hidden rounded-sm relative">
            <div
              class="absolute inset-0 bg-[var(--color-primary)]/10 group-hover:bg-transparent transition-colors z-10"
            >
            </div>
            <Image
              alt="Respaldo Legal"
              class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
              src={respaldo}
            />
          </div>
          <span
            class="material-symbols-outlined text-[var(--color-primary)] text-3xl mb-4 block transform group-hover:rotate-12 transition-transform"
            >balance</span
          >
          <h3
            class="font-playfair font-bold text-2xl text-[var(--color-on-surface)] mb-4"
          >
            Representación Jurídica
          </h3>
          <p
            class="font-inter font-light text-base text-[var(--color-on-surface-variant)]"
          >
            Asesoría legal especializada para proteger los intereses de tu
            empresa ante diversas instancias gubernamentales y laborales,
            asegurando certidumbre en cada operación.
          </p>
        </div>

        <!-- Tarjeta 2 -->
        <div
          class="group reveal card-glow p-4 rounded-xl border border-transparent bg-white shadow-sm"
          style="transition-delay: 100ms;"
        >
          <div class="h-64 mb-8 overflow-hidden rounded-sm relative">
            <div
              class="absolute inset-0 bg-[var(--color-primary)]/10 group-hover:bg-transparent transition-colors z-10"
            >
            </div>
            <Image
              alt="Capacitación y talleres"
              class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
              src={capacitacion}
            />
          </div>
          <span
            class="material-symbols-outlined text-[var(--color-primary)] text-3xl mb-4 block transform group-hover:rotate-12 transition-transform"
            >model_training</span
          >
          <h3
            class="font-playfair font-bold text-2xl text-[var(--color-on-surface)] mb-4"
          >
            Capacitación de Excelencia
          </h3>
          <p
            class="font-inter font-light text-base text-[var(--color-on-surface-variant)]"
          >
            Programas de formación continua, talleres ejecutivos y seminarios
            diseñados para actualizar las competencias críticas de tu equipo de
            trabajo y liderazgo.
          </p>
        </div>

        <!-- Tarjeta 3 -->
        <div
          class="group reveal card-glow p-4 rounded-xl border border-transparent bg-white shadow-sm"
          style="transition-delay: 200ms;"
        >
          <div class="h-64 mb-8 overflow-hidden rounded-sm relative">
            <div
              class="absolute inset-0 bg-[var(--color-primary)]/10 group-hover:bg-transparent transition-colors z-10"
            >
            </div>
            <Image
              alt="Networking"
              class="object-cover w-full h-full group-hover:scale-105 transition-transform duration-700"
              src={networking}
            />
          </div>
          <span
            class="material-symbols-outlined text-[var(--color-primary)] text-3xl mb-4 block transform group-hover:rotate-12 transition-transform"
            >forum</span
          >
          <h3
            class="font-playfair font-bold text-2xl text-[var(--color-on-surface)] mb-4"
          >
            Networking Estratégico
          </h3>
          <p
            class="font-inter font-light text-base text-[var(--color-on-surface-variant)]"
          >
            Acceso a círculos exclusivos para conectar con otros líderes
