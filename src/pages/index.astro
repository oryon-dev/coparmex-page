---
import BaseLayout from "../layouts/BaseLayout.astro";
import SociosCarousel from "../components/home/SociosCarousel.astro";

import { Image, getImage } from "astro:assets";
import valladolidHero from "../assets/pages/home/valladolid-hero.png";
import esencia from "../assets/pages/home/esencia-coparmex.png";
import alianza from "../assets/pages/home/alianza.png";
import respaldo from "../assets/pages/home/legal.png";
import networking from "../assets/pages/home/networking.png";
import capacitacion from "../assets/pages/home/capacitacion.png";
import beneficios from "../assets/pages/home/beneficios.png";
import GMesonesLogo from "../assets/shared/socios/grupo-mesones-logo.png";

const optBackground = await getImage({
  src: valladolidHero,
  format: "webp",
  width: 1920,
  quality: "high",
});
---

<BaseLayout title="Inicio">
  <!-- Editorial Hero Section -->
  <section
    class="relative w-full h-[800px] flex items-center justify-center overflow-hidden"
  >
    <!-- WebGL Background Placeholder -->
    <div id="shader-bg"></div>

    <div
      class="absolute inset-0 bg-cover bg-center scale-105 transition-transform duration-[15000ms] ease-linear"
      id="hero-bg-zoom"
      style={`background-image: url('${optBackground.src}');`}
    >
    </div>
    <div class="absolute inset-0 hero-overlay z-[2]"></div>

    <div
      class="relative z-10 text-center max-w-5xl px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] w-full reveal"
    >
      <div
        class="glass-card p-8 md:p-20 rounded-2xl hover:bg-white/10 transition-all duration-500 mx-4 md:mx-0"
      >
        <h1
          class="font-playfair font-black text-4xl md:text-6xl text-[var(--color-on-primary)] mb-8 leading-tight heading-transition"
        >
          Liderazgo Empresarial para el Futuro de Valladolid
        </h1>
        <p
          class="font-inter font-light text-lg md:text-xl text-[var(--color-on-primary)]/90 mb-12 max-w-3xl mx-auto"
        >
          Forjando alianzas estratégicas, defendiendo la libre empresa y
          catalizando el crecimiento económico regional a través de una
          representación institucional de excelencia.
        </p>
        <div
          class="flex flex-col sm:flex-row gap-6 justify-center items-center"
        >
          <a
            href="/servicios"
            class="bg-[var(--color-surface-container-lowest)] text-[var(--color-primary)] font-montserrat font-semibold px-10 py-4 hover:bg-[var(--color-surface-container-high)] transition-all shadow-xl tracking-widest uppercase text-sm transform hover:scale-105 hover:-translate-y-1 w-full sm:w-auto text-center"
          >
            Descubre el Impacto
          </a>
          <a
            href="/socios/directorio"
            class="bg-transparent border border-[var(--color-on-primary)] text-[var(--color-on-primary)] font-montserrat font-semibold px-10 py-4 hover:bg-[var(--color-on-primary)]/10 transition-all tracking-widest uppercase text-sm transform hover:scale-105 hover:-translate-y-1 w-full sm:w-auto text-center"
          >
            Ver Comunidad
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Red de Socios Infinite Scroll -->
  <SociosCarousel />

  <!-- Narrative Structure: Historia & Visión -->
  <section
    class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-[var(--color-surface-container-lowest)] overflow-hidden"
    id="historia"
  >
    <div
      class="max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <!-- Staggered Block 1 -->
      <div
        class="flex flex-col md:flex-row items-center gap-10 md:gap-16 mb-24 reveal"
      >
        <div class="w-full md:w-1/2">
          <div
            class="relative w-full aspect-[4/3] editorial-image-mask overflow-hidden group"
          >
            <Image
              alt="Professional meeting"
              class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-1000"
              src={esencia}
            />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <span
            class="text-[var(--color-primary)] font-montserrat font-semibold text-xs tracking-widest uppercase mb-4 block"
            >Nuestra Esencia</span
          >
          <h2
            class="font-playfair font-bold text-3xl md:text-5xl text-[var(--color-on-surface)] mb-8 heading-transition leading-tight"
          >
            Más que una representación, somos el motor del cambio.
          </h2>
          <p
            class="font-inter font-light text-lg text-[var(--color-on-surface-variant)] mb-6 leading-relaxed"
          >
            COPARMEX Valladolid se erige como el bastión del empresariado local.
            Somos un sindicato patronal independiente y de afiliación
            voluntaria, donde confluyen visiones de todos los tamaños y sectores
            para tejer un ecosistema empresarial resiliente.
          </p>
          <p
            class="font-inter text-base text-[var(--color-on-surface-variant)] leading-relaxed"
          >
            Defendemos con firmeza los legítimos intereses del sector,
            promoviendo un entorno donde la inversión florece, la creación de
            empleo se multiplica y el desarrollo económico sostenible se
            convierte en la norma para nuestra región.
          </p>
        </div>
      </div>

      <!-- Staggered Block 2 -->
      <div
        class="flex flex-col md:flex-row-reverse items-center gap-10 md:gap-16 reveal"
      >
        <div class="w-full md:w-1/2">
          <div
            class="relative w-full aspect-[4/3] editorial-image-mask-alt overflow-hidden group"
          >
            <Image
              alt="Handshake"
              class="object-cover w-full h-full transform group-hover:scale-110 transition-transform duration-1000"
              src={alianza}
            />
          </div>
        </div>
        <div class="w-full md:w-1/2">
          <span
            class="text-[var(--color-primary)] font-montserrat font-semibold text-xs tracking-widest uppercase mb-4 block"
            >Visión Estratégica</span
          >
          <h2
            class="font-playfair font-bold text-3xl md:text-5xl text-[var(--color-on-surface)] mb-8 heading-transition leading-tight"
          >
            Impulsando la competitividad a través de la unión.
          </h2>
          <p
            class="font-inter font-light text-lg text-[var(--color-on-surface-variant)] mb-6 leading-relaxed"
          >
            Nuestra misión trasciende el presente. Visualizamos un Valladolid
            donde cada empresa, desde la más incipiente hasta la más
            consolidada, posea las herramientas para competir a nivel global.
          </p>
          <div class="grid grid-cols-2 gap-8 mt-10">
            <div
              class="border-l-2 border-[var(--color-primary)] pl-6 hover:border-l-4 transition-all"
            >
              <h3
                class="font-playfair font-bold text-4xl text-[var(--color-primary)] mb-2"
              >
                +50
              </h3>
              <p
                class="font-montserrat font-semibold text-xs text-[var(--color-on-surface-variant)] uppercase tracking-wider"
              >
                Empresas Aliadas
              </p>
            </div>
            <div
              class="border-l-2 border-[var(--color-primary)] pl-6 hover:border-l-4 transition-all"
            >
              <h3
                class="font-playfair font-bold text-4xl text-[var(--color-primary)] mb-2"
              >
                100%
              </h3>
              <p
                class="font-montserrat font-semibold text-xs text-[var(--color-on-surface-variant)] uppercase tracking-wider"
              >
                Compromiso Legal
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Elegant Services Layout -->
  <section
    class="py-[var(--spacing-margin-desktop)] md:py-[var(--spacing-section-gap)] bg-[var(--color-surface-bright)]"
    id="servicios"
  >
    <div
      class="max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <div class="text-center mb-16 md:mb-20 reveal">
        <span
