  {
    id: 1,
    name: "Grupo Díaz Alcocer",
    logo: GDiazAlcocerLogo,
    category: "Comercio",
    description:
      "Distribución y comercialización de productos con un alto estándar de calidad para la región.",
    icon: "storefront",
    facebook: "https://www.facebook.com/grupodiazalcocer/",
    instagram: "https://www.instagram.com/grupodiazalcocer/",
    linkedin: "https://www.linkedin.com/in/isaac-díaz-alcocer-15a4606b/",
  },
  {
    id: 2,
    name: "Grupo Merza",
    logo: GMerzaLogo,
    category: "Comercio",
    description:
      "Red de distribución mayorista de bienes de consumo masivo en toda la península.",
    icon: "shopping_cart",
    website: "https://www.grupomerza.com",
    facebook: "https://www.facebook.com/TiendasMerza/",
    instagram: "https://www.instagram.com/tiendasmerza/",
    linkedin: "https://www.linkedin.com/company/abarrotera-del-duero/",
  },
  {
    id: 3,
    name: "Grupo Mesones",
    logo: GMesonesLogo,
    category: "Turismo",
    description:
      "Referente en hospitalidad, ofreciendo experiencias únicas con altos estándares de calidad.",
    icon: "hotel",
    website: "https://www.mesondelmarques.com/grupo-mesones",
    linkedin: "https://www.linkedin.com/company/grupo-mesones/",
    instagram: "https://www.instagram.com/popular/grupo-mesones/",
    facebook: "https://www.facebook.com/talentogrupomesones/",
  },
  {
    id: 4,
    name: "Universidad De Valladolid Yucatán",
    logo: UVYLogo,
    category: "Educación",
    description:
      "Formando a los futuros líderes y profesionales de excelencia para el desarrollo del sureste.",
    icon: "school",
    website: "https://www.uvy.edu.mx",
    facebook: "https://www.facebook.com/OFICIALUVY/",
    instagram: "https://www.instagram.com/oficialuvy",
  },
  {
    id: 5,
    name: "Trivasa",
    logo: TrivasaLogo,
    category: "Industria",
    description:
      "Producción e innovación de materiales para la construcción e infraestructura de primer nivel.",
    icon: "precision_manufacturing",
    website: "https://www.trivasa.com.mx",
    linkedin: "https://www.linkedin.com/company/trivasa",
    facebook: "https://www.facebook.com/Trivasa.Valladolid/",
  },
  {
    id: 6,
    name: "Vallazoo",
    logo: VallazooLogo,
    category: "Turismo",
    description:
      "Reserva natural y zoológico dedicado a la preservación de la flora y fauna endémica.",
    icon: "pets",
    website: "https://www.vallazoo.mx",
    facebook: "https://facebook.com/vallazoo",
    instagram: "https://instagram.com/vallazoo",
  },
  {
    id: 7,
    name: "La Casona De Valladolid",
