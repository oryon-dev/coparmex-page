---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import imgAfiliacion from "../../assets/pages/socios/afiliacion.png";

const beneficios = [
  {
    icon: "gavel",
    title: "Representación y Defensa",
    description:
      "Voz activa ante instancias gubernamentales para proteger los intereses legítimos de tu sector empresarial.",
  },
  {
    icon: "handshake",
    title: "Networking de Alto Nivel",
    description:
      "Conexión directa con los tomadores de decisiones más influyentes de la península y el país.",
  },
  {
    icon: "school",
    title: "Capacitación Continua",
    description:
      "Acceso preferencial a seminarios, diplomados y talleres especializados para tu equipo directivo.",
  },
  {
    icon: "storefront",
    title: "Visibilidad Empresarial",
    description:
      "Posicionamiento de tu marca en nuestros canales oficiales, eventos y directorio corporativo exclusivo.",
  },
  {
    icon: "balance",
    title: "Asesoría Legal y Fiscal",
    description:
      "Consultoría experta en normativas vigentes para asegurar la salud jurídica de tu organización.",
  },
  {
    icon: "local_offer",
    title: "Convenios B2B",
    description:
      "Programa de beneficios y descuentos exclusivos en servicios de otros socios afiliados.",
  },
];

const pasos = [
  {
    num: "1",
    title: "Solicitud inicial",
    desc: "Completa nuestro formulario digital de contacto.",
  },
  {
    num: "2",
    title: "Entrega de documentos",
    desc: "Validación de requisitos legales y constitutivos.",
  },
  {
    num: "3",
    title: "Aportación de cuota",
    desc: "Suscripción anual según el tamaño de tu empresa.",
  },
  {
    num: "4",
    title: "¡Bienvenido socio!",
    desc: "Integración formal a la comunidad COPARMEX.",
  },
];

const testimonios = [
  {
    quote:
      "Afiliarnos a COPARMEX Valladolid nos abrió puertas que no sabíamos que existían. El networking es genuino y de alto impacto.",
    author: "Ing. Ricardo Alcocer",
    company: "Director General, ConstruVall",
  },
  {
    quote:
      "La capacitación para mis mandos medios ha sido clave para mejorar nuestra eficiencia operativa este año.",
    author: "Lic. María Fernández",
    company: "Fundadora, Textiles del Oriente",
  },
  {
    quote:
      "Contar con respaldo jurídico y fiscal nos da la tranquilidad necesaria para enfocarnos en lo que mejor sabemos hacer: crecer.",
    author: "Arq. Eduardo Solís",
    company: "Socio, Desarrollos Peninsulares",
  },
];
---

<BaseLayout title="Beneficios de Afiliación | COPARMEX Valladolid">
  <main class="w-full bg-white">
    <!-- Hero Section -->
    <section
      class="relative py-16 md:py-24 px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] overflow-hidden"
    >
      <div
        class="max-w-[var(--spacing-container-max-width)] mx-auto grid md:grid-cols-2 items-center gap-12"
      >
        <div class="z-10 space-y-8 animate-fade-in">
          <h1
            class="font-playfair text-4xl md:text-5xl lg:text-6xl font-black leading-tight text-[var(--color-primary)]"
          >
            Impulsa el crecimiento de tu empresa
          </h1>
          <p
            class="font-inter font-light text-lg md:text-xl text-[var(--color-on-surface-variant)] max-w-lg leading-relaxed"
          >
            Únete a la red empresarial más importante de la región y accede a
            beneficios exclusivos diseñados para fortalecer tu liderazgo y
            competitividad.
          </p>
          <a
            href="/contacto"
            class="inline-block font-montserrat text-sm font-bold tracking-wider uppercase bg-[var(--color-primary)] text-white px-10 py-4 md:py-5 rounded-full shadow-md hover:shadow-xl hover:-translate-y-1 hover:bg-[var(--color-primary-container)] transition-all duration-300"
          >
            Quiero Afiliarme
          </a>
        </div>

        <div class="relative">
          <div
            class="rounded-3xl overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-700 aspect-[4/3]"
          >
            <Image
              class="w-full h-full object-cover"
              src={imgAfiliacion}
              alt="Networking Empresarial"
            />
          </div>
          <div
            class="absolute -bottom-6 -left-6 bg-white p-6 md:p-8 rounded-3xl shadow-xl hidden md:block border border-[var(--color-outline-variant)]/30"
          >
            <div class="flex items-center gap-4">
              <span
                class="text-[var(--color-primary)] font-playfair text-4xl font-bold"
                >50+</span
              >
              <span
                class="font-inter text-sm font-semibold text-[var(--color-on-surface-variant)] leading-tight"
                >Socios Activos<br />en la Región</span
              >
            </div>
          </div>
        </div>
      </div>
      <!-- Círculo decorativo -->
      <div
        class="absolute top-0 right-0 -mr-24 -mt-24 w-96 h-96 bg-[var(--color-primary)]/5 rounded-full blur-3xl -z-10"
      >
      </div>
    </section>

    <!-- Grid de Beneficios -->
    <section
      class="py-16 md:py-24 bg-[var(--color-surface-bright)] px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)]"
    >
      <div class="max-w-[var(--spacing-container-max-width)] mx-auto">
        <div class="text-center mb-16 space-y-4 reveal">
          <h2
            class="font-playfair text-4xl md:text-5xl font-bold text-[var(--color-primary)]"
          >
            Beneficios Exclusivos
          </h2>
          <p
            class="font-montserrat text-sm tracking-[0.2em] uppercase text-[var(--color-on-surface-variant)] font-semibold"
          >
            Valor para tu empresa
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8"
        >
          {
            beneficios.map((beneficio) => (
              <div class="benefit-card bg-white p-8 md:p-10 rounded-3xl border border-[var(--color-outline-variant)]/30 shadow-sm hover:shadow-xl transition-all duration-500 group reveal">
                <div class="icon-box w-16 h-16 bg-[var(--color-surface-container)] flex items-center justify-center rounded-2xl mb-8 transition-all duration-500 text-[var(--color-primary)]">
                  <span class="material-symbols-outlined text-3xl">
                    {beneficio.icon}
                  </span>
                </div>
                <h3 class="font-montserrat text-lg font-bold uppercase tracking-wider mb-4 group-hover:text-[var(--color-primary)] transition-colors">
                  {beneficio.title}
                </h3>
                <p class="font-inter font-light text-[var(--color-on-surface-variant)] leading-relaxed">
                  {beneficio.description}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Proceso de Afiliación (Línea de Tiempo) -->
    <section
      class="py-16 md:py-24 px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] bg-white"
    >
      <div class="max-w-[var(--spacing-container-max-width)] mx-auto">
        <h2
          class="font-playfair text-3xl md:text-4xl font-bold text-center mb-16 md:mb-20 text-[var(--color-primary)] reveal"
        >
          Proceso de Afiliación
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-4 gap-12 relative reveal">
          {
            pasos.map((paso, index) => (
              <div
                class={`relative z-10 text-center space-y-4 ${index !== pasos.length - 1 ? "process-line" : ""}`}
              >
                <div
                  class={`w-14 h-14 ${index === pasos.length - 1 ? "bg-[var(--color-tertiary)]" : "bg-[var(--color-primary)]"} text-white rounded-full flex items-center justify-center mx-auto font-montserrat font-bold text-xl border-4 border-white shadow-md transition-transform hover:scale-110 duration-300`}
                >
                  {paso.num}
                </div>
                <h4 class="font-montserrat font-bold text-sm md:text-base tracking-wider uppercase pt-4 text-[var(--color-primary)]">
                  {paso.title}
                </h4>
                <p class="font-inter font-light text-sm text-[var(--color-on-surface-variant)]">
                  {paso.desc}
                </p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Testimonios -->
    <section
      class="py-16 md:py-24 px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] bg-[var(--color-surface-bright)] border-y border-[var(--color-outline-variant)]/20"
    >
      <div class="max-w-[var(--spacing-container-max-width)] mx-auto">
        <h2
          class="font-playfair text-3xl md:text-4xl font-bold text-center mb-16 text-[var(--color-primary)] reveal"
        >
          Casos de Éxito
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
          {
            testimonios.map((testimonio) => (
              <div class="bg-white p-8 md:p-10 rounded-3xl border border-[var(--color-outline-variant)]/30 flex flex-col justify-between italic shadow-sm hover:shadow-md transition-shadow reveal">
                <div>
                  <span class="material-symbols-outlined text-[var(--color-primary-fixed-dim)] text-4xl md:text-5xl mb-6">
                    format_quote
                  </span>
                  <p class="font-inter font-light text-base md:text-lg text-[var(--color-on-surface)] leading-relaxed mb-8">
                    "{testimonio.quote}"
                  </p>
                </div>
                <div class="not-italic border-t border-[var(--color-outline-variant)]/20 pt-6">
                  <p class="font-montserrat font-bold text-sm uppercase tracking-widest text-[var(--color-primary)]">
                    {testimonio.author}
                  </p>
                  <p class="font-inter text-xs text-[var(--color-on-surface-variant)] uppercase mt-1">
                    {testimonio.company}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- CTA Final Banner -->
    <section
      class="py-16 md:py-20 px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] bg-white"
    >
      <div
        class="max-w-[var(--spacing-container-max-width)] mx-auto bg-[var(--color-primary)] rounded-3xl p-10 md:p-20 text-center text-white relative overflow-hidden shadow-2xl reveal"
      >
        <div class="relative z-10 max-w-3xl mx-auto space-y-8">
          <h2
            class="font-playfair text-3xl md:text-4xl lg:text-5xl font-bold leading-tight"
          >
            Únete a los más de 50 empresarios que ya transforman la región.
          </h2>
          <div class="flex flex-col sm:flex-row gap-6 justify-center pt-4">
            <a
              href="/contacto"
              class="bg-white text-[var(--color-primary)] font-montserrat text-sm font-bold tracking-wider uppercase px-10 py-4 md:py-5 rounded-full hover:bg-[var(--color-surface-container)] transition-colors shadow-lg"
            >
              Contactar a un Asesor
            </a>
          </div>
        </div>

        <!-- Abstract patterns -->
        <div
          class="absolute -top-12 -right-12 w-64 h-64 bg-white/10 rounded-full blur-2xl"
        >
        </div>
        <div
          class="absolute -bottom-12 -left-12 w-64 h-64 bg-[var(--color-secondary)]/30 rounded-full blur-2xl"
        >
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Efecto de Hover para Iconos de Beneficios */
  .benefit-card:hover .icon-box {
    transform: translateY(-8px);
    background-color: var(--color-primary);
    color: white;
  }

  /* Línea conectora para el Stepper (Timeline) */
  .process-line::after {
    content: "";
    position: absolute;
    top: 28px;
    left: calc(50% + 28px);
    right: calc(-50% + 28px);
    height: 2px;
    /* Usa un gradiente punteado sutil para conectar los pasos */
    background: repeating-linear-gradient(
      to right,
      var(--color-outline-variant) 0,
      var(--color-outline-variant) 6px,
      transparent 6px,
      transparent 12px
    );
    z-index: -1;
    opacity: 0.5;
  }

  @media (max-width: 768px) {
    .process-line::after {
      display: none;
    }
  }
</style>

<script>
  // Intersection Observer para las animaciones reveal
  document.addEventListener("DOMContentLoaded", () => {
    const observerOptions = { threshold: 0.1, rootMargin: "0px 0px -50px 0px" };

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("opacity-100", "translate-y-0");
          entry.target.classList.remove("opacity-0", "translate-y-8");
          // Opcional: Desactivar la observación después de animar
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);

    // Seleccionamos elementos clave
    document.querySelectorAll(".reveal").forEach((el) => {
      el.classList.add(
        "transition-all",
        "duration-700",
        "opacity-0",
        "translate-y-8",
      );
      observer.observe(el);
    });
  });
</script>
