---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Página no encontrada">
  <section
    class="flex-grow flex flex-col items-center justify-center w-full px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] py-12 relative overflow-hidden bg-[var(--color-surface-bright)]"
  >
    <div
      class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-[var(--color-primary-fixed)] rounded-full mix-blend-multiply filter blur-[120px] opacity-40 pointer-events-none transform -translate-y-1/2"
    >
    </div>

    <div
      class="relative z-10 w-full max-w-4xl text-center flex flex-col items-center"
    >
      <h1
        class="font-montserrat font-black text-[var(--color-primary)] tracking-tighter drop-shadow-xl select-none m-0 p-0 pb-4 md:pb-8"
        style="font-size: clamp(120px, 25vw, 280px); line-height: 0.85;"
      >
        404
      </h1>

      <div
        class="bg-white/95 backdrop-blur-xl rounded-3xl shadow-[0_20px_50px_-15px_rgba(0,71,187,0.2)] border-0 p-8 md:p-14 mt-0 mx-auto max-w-2xl relative z-20"
      >
        <h2
          class="font-playfair text-3xl md:text-4xl font-bold text-[var(--color-on-surface)] mb-4"
        >
          Parece que te perdiste
        </h2>

        <p
          class="font-inter text-base md:text-lg text-[var(--color-on-surface-variant)] mb-10 font-light leading-relaxed"
        >
          La página que buscas no está disponible, fue movida o no ha existido
          nunca. Pero no te preocupes, el camino de regreso es fácil.
        </p>

        <div class="flex justify-center">
          <a
            href="/"
            class="inline-flex items-center justify-center gap-3 bg-[var(--color-primary)] text-[var(--color-on-primary)] font-inter font-semibold px-12 py-4 rounded-full uppercase tracking-widest text-sm hover:opacity-90 transition-all transform hover:-translate-y-1 shadow-[0_10px_20px_rgba(0,71,187,0.3)] w-full sm:w-auto"
          >
            <span class="material-symbols-outlined text-[22px]">home</span>
            Volver al Inicio
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
