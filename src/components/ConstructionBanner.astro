---
// src/components/ConstructionBanner.astro
---

<div
  id="construction-banner"
  class="fixed bottom-4 md:bottom-8 left-1/2 -translate-x-1/2 w-[90%] md:w-auto max-w-2xl z-[100] transition-transform duration-500 translate-y-full opacity-0"
>
  <div
    class="bg-white/95 backdrop-blur-md border-l-4 border-[var(--color-primary)] shadow-2xl rounded-xl p-4 md:p-6 flex flex-col md:flex-row items-center gap-4 md:gap-6 border-y border-r border-[var(--color-outline-variant)]/30"
  >
    <!-- Ícono -->
    <div
      class="hidden md:flex w-12 h-12 bg-amber-100 text-amber-600 rounded-full items-center justify-center shrink-0"
    >
      <span class="material-symbols-outlined text-2xl">construction</span>
    </div>

    <!-- Texto -->
    <div class="flex-grow text-center md:text-left">
      <h4
        class="font-montserrat font-bold text-sm md:text-base text-[var(--color-on-surface)] uppercase tracking-wider mb-1"
      >
        Sitio en Construcción
      </h4>
      <p
        class="font-inter text-xs md:text-sm text-[var(--color-on-surface-variant)] leading-relaxed"
      >
        Estamos trabajando en la nueva experiencia digital de COPARMEX
        Valladolid. Puedes navegar para revisar el diseño, pero algunas
        funciones o textos podrían ser temporales.
      </p>
    </div>

    <!-- Botón de Cerrar -->
    <button
      id="close-banner"
      class="w-full md:w-auto bg-[var(--color-primary)] text-white font-montserrat font-bold text-xs uppercase tracking-wider px-6 py-3 rounded-lg hover:bg-[var(--color-primary-container)] transition-colors shrink-0"
    >
      Entendido
    </button>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const banner = document.getElementById("construction-banner");
    const closeBtn = document.getElementById("close-banner");

    const isBannerDismissed = sessionStorage.getItem(
      "coparmex_construction_dismissed",
    );

    if (!isBannerDismissed && banner) {
      setTimeout(() => {
        banner.classList.remove("translate-y-full", "opacity-0");
        banner.classList.add("translate-y-0", "opacity-100");
      }, 500); // Aparece medio segundo después de cargar la página
    }

    if (closeBtn && banner) {
      closeBtn.addEventListener("click", () => {
        banner.classList.remove("translate-y-0", "opacity-100");
        banner.classList.add("translate-y-full", "opacity-0");

        sessionStorage.setItem("coparmex_construction_dismissed", "true");

        setTimeout(() => {
          banner.style.display = "none";
        }, 500);
      });
    }
  });
</script>
