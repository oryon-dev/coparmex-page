---
// 1. Importamos el componente nativo de imágenes de Astro
import { Image } from "astro:assets";
import logoFooter from "../assets/branding/Coparmex-valladolid-logo-footer.png";

const currentYear = new Date().getFullYear();

const footerLinks = [
  { label: "Liderazgo", href: "#" },
  { label: "Nuestra Historia", href: "/coparmex/historia" },
  { label: "Impacto y Servicios", href: "/servicios" },
  { label: "Directorio de Socios", href: "/socios" },
];
---

<footer
  class="bg-[var(--color-tertiary)] w-full border-t border-[var(--color-outline-variant)]/20 relative z-10 overflow-hidden"
>
  <div
    class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 max-w-[var(--spacing-container-max-width)] mx-auto px-[var(--spacing-margin-mobile)] md:px-[var(--spacing-margin-desktop)] py-12 md:py-24"
  >
    <div class="md:col-span-5">
      <Image
        src={logoFooter}
        alt="Logotipo de COPARMEX Valladolid"
        inferSize={true}
        class="h-14 w-auto object-contain mb-6 brightness-0 invert"
      />

      <p
        class="font-inter text-lg text-[var(--color-on-tertiary)]/70 mb-6 md:mb-8 font-light leading-relaxed max-w-sm"
      >
        Impulsando el desarrollo empresarial y la competitividad institucional
        en la región sureste.
      </p>
      <p class="font-inter text-sm text-[var(--color-on-tertiary)]/50">
        © {currentYear} COPARMEX Valladolid.<br />Todos los derechos reservados.
      </p>
    </div>

    <div class="md:col-span-3">
      <h4
        class="font-inter font-semibold text-[var(--color-on-tertiary)] mb-6 md:mb-8 md:mt-6 uppercase tracking-widest text-xs opacity-70"
      >
        Navegación
      </h4>
      <ul class="space-y-3 md:space-y-4">
        {
          footerLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="nav-link-footer font-inter text-base text-[var(--color-on-tertiary)]/90 hover:text-[var(--color-on-tertiary)] transition-colors font-light inline-block"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="md:col-span-4">
      <h4
        class="font-inter font-semibold text-[var(--color-on-tertiary)] mb-6 md:mb-8 md:mt-6 uppercase tracking-widest text-xs opacity-70"
      >
        Contacto Institucional
      </h4>
      <address
        class="font-inter text-base text-[var(--color-on-tertiary)]/90 not-italic space-y-3 md:space-y-4 font-light flex flex-col"
      >
        <p>Calle 62 N° 129 entre 25 y 29, Fraccionamiento Xcorazón.</p>
        <p>Valladolid, Yucatán, México.</p>

        <a
          href="tel:+529858560731"
          class="block pt-4 border-t border-[var(--color-on-tertiary)]/20 hover:text-white transition-colors"
        >
          Tel: (985) 856 0731
        </a>

        <a
          href="mailto:contacto@coparmexvalladolid.org.mx"
          class="block hover:text-white transition-colors"
        >
          Email: contacto@coparmexvalladolid.org.mx
        </a>
      </address>

      <!-- Redes / Botones de acción -->
      <div class="mt-8 md:mt-10 flex gap-6 items-center">
        <a
          href="https://facebook.com/tu-pagina"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-[var(--color-on-tertiary)]/70 hover:text-[var(--color-on-tertiary)] transition-all transform hover:scale-125"
          aria-label="Ir a Facebook institucional"
        >
          <svg class="w-6 h-6 fill-current block" viewBox="0 0 24 24">
            <path
              d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"
            ></path>
          </svg>
        </a>

        <a
          href="https://instagram.com/tu-perfil"
          target="_blank"
          rel="noopener noreferrer"
          class="block text-[var(--color-on-tertiary)]/70 hover:text-[var(--color-on-tertiary)] transition-all transform hover:scale-125"
          aria-label="Ir a Instagram institucional"
        >
          <svg class="w-6 h-6 fill-current block" viewBox="0 0 24 24">
            <path
              fill-rule="evenodd"
              clip-rule="evenodd"
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.051.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
            ></path>
          </svg>
        </a>

        <a
          href="mailto:contacto@coparmexvalladolid.org.mx"
          class="block text-[var(--color-on-tertiary)]/70 hover:text-[var(--color-on-tertiary)] transition-all transform hover:scale-125"
          aria-label="Enviar correo electrónico"
        >
          <span
            class="material-symbols-outlined block text-[24px] w-6 h-6 leading-[24px] text-center"
            >mail</span
          >
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .nav-link-footer {
    position: relative;
  }
  .nav-link-footer::after {
    content: "";
    position: absolute;
    width: 0;
    height: 1px;
    bottom: -2px;
    left: 0;
    background-color: currentColor;
    transition: width 0.3s ease;
  }
  .nav-link-footer:hover::after {
    width: 100%;
  }
</style>
