---
import { Image } from "astro:assets";

interface Props {
  role: string;
  name: string;
  company?: string;
  image: any;
  email?: string;
  linkedin?: string;
}

const { role, name, company, image, email, linkedin } = Astro.props;
---

<div
  class="bg-white border border-[var(--color-outline-variant)]/40 rounded-xl overflow-hidden w-full flex flex-col sm:flex-row shadow-sm hover:-translate-y-2 hover:shadow-lg transition-all duration-300 group"
>
  <!-- Contenedor de Imagen -->
  <div
    class="sm:w-2/5 aspect-[4/5] sm:aspect-auto sm:h-auto relative overflow-hidden bg-[var(--color-surface-container)]"
  >
    <Image
      src={image}
      alt={`Fotografía de ${name}`}
      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
    />
  </div>

  <!-- Contenedor de Texto -->
  <div class="sm:w-3/5 p-6 md:p-8 flex flex-col justify-center">
    <span
      class="text-[var(--color-primary)] font-montserrat font-bold text-xs md:text-sm mb-2 uppercase tracking-wide"
    >
      {role}
    </span>
    <h3
      class="font-playfair font-bold text-2xl md:text-3xl text-[var(--color-on-surface)] mb-2"
    >
      {name}
    </h3>
    {
      company && (
        <p class="font-inter text-[var(--color-on-surface-variant)] mb-6 italic text-sm md:text-base font-light">
          {company}
        </p>
      )
    }

    <!-- Botonera de Contacto -->
    <div class="mt-auto flex gap-4">
      {
        email && (
          <a
            href={`mailto:${email}`}
            class="text-[var(--color-primary)] hover:text-[var(--color-primary-container)] transition-colors"
            title="Enviar correo"
          >
            <span class="material-symbols-outlined text-[20px]">
              alternate_email
            </span>
          </a>
        )
      }
      {
        linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="text-[var(--color-primary)] hover:text-[var(--color-primary-container)] transition-colors"
            title="Perfil profesional"
          >
            <span class="material-symbols-outlined text-[20px]">share</span>
          </a>
        )
      }
    </div>
  </div>
</div>
